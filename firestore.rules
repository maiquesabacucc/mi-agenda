rules_version = '2';
// Agenda privada: la primera cuenta que entra se queda como dueña (config/owner)
// y solo esa cuenta puede leer y escribir sus datos (users/<su id>/...).
// Si alguien crea otra cuenta, no puede leer ni guardar nada.
// Pega esto en Firebase > Firestore Database > Reglas y pulsa Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function ownerPath() { return /databases/$(database)/documents/config/owner; }
    function isOwner() {
      return request.auth != null && exists(ownerPath()) && get(ownerPath()).data.uid == request.auth.uid;
    }

    match /config/owner {
      // Se puede consultar sin entrar, para esconder el botón "Crear mi cuenta" cuando ya hay dueño
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'since']);
      allow update: if false;
      allow delete: if isOwner();
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner() && request.auth.uid == uid;
    }

    // Tabla de alarmas del atajo «Me voy a dormir»: se lee sin iniciar sesión, pero solo si sabes la clave
    // secreta, que es el nombre del documento. No se puede listar ni escribir desde fuera.
    match /users/{uid}/atajo/{k} {
      allow get: if k == get(/databases/$(database)/documents/users/$(uid)/private/health).data.key;
    }

    // Buzón del Atajo de Apple Salud: puede dejar datos sin iniciar sesión, pero solo
    // si empiezan por tu clave secreta (users/<tú>/private/health). Leerlos, solo tu cuenta.
    match /users/{uid}/inbox/{id} {
      allow create: if request.resource.data.keys().hasOnly(['raw'])
        && request.resource.data.raw is string
        && request.resource.data.raw.size() < 200000
        && request.resource.data.raw.split('[|]')[0] == get(/databases/$(database)/documents/users/$(uid)/private/health).data.key;
    }
  }
}
